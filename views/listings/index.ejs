<% layout("/layouts/boilerplate") %>

<style>

    .filters-wrapper {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 1rem;
        padding-top: 2rem;
    }

    #filters {
        display: flex;
        flex: 1;
        min-width: 0;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
        white-space: nowrap;
        align-items: center;
    }

    #filters::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .filter {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: fit-content;
        opacity: 0.7;
    }

    .filter:hover {
        opacity: 1;
        border-bottom: 2px solid #444;
    }

    .active-filter {
        opacity: 1;
        border-bottom: 2px solid #ff385c;
    }

    .icon {
        text-align: center;
        font-size: 1.4rem;
    }

    .filter p {
        margin: 0.4rem 0 0;
        font-size: 0.8rem;
    }

    .active-filter .icon i {
        color: #ff385c;
    }
    .active-filter p {
        color: #ff385c;
        font-weight: 600;
    }

    .tax-togel {
        border: 1px solid black;
        height: 3.5rem;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    /* Tablet */
    @media (max-width: 768px) {
        #filters {
            gap: 1.2rem;
        }
        .icon {
            font-size: 1.2rem;
        }
        .filter p {
            font-size: 0.75rem;
        }
    }

    /* Mobile — tax-togel yahan niche chala jayega */
  @media (max-width: 480px) {
    .tax-togel {
        flex-shrink: 0;
        height: auto;
        padding: 0.75rem 1.25rem;
        margin: 1rem auto 0;
        width: fit-content;
    }

    .tax-togel .form-check.form-switch.form-check-reverse {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 0.75rem !important;
        padding: 0 !important;
    }

    .tax-togel .form-check-input {
        margin: 0 !important;
        flex-shrink: 0;
        width: 2.5em;
        height: 1.3em;
    }

    .tax-togel .form-check-label {
        margin: 0 !important;
        white-space: nowrap !important;
        font-size: 0.85rem;
        order: -1;   /* label ko switch se pehle (left side) dikhane ke liye */
    }
}
</style>

<div class="filters-wrapper">

    <div id="filters">

        <a href="/listings?category=trending" class="filter text-decoration-none text-dark <%= activeCategory === 'trending' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-fire"></i></div>
            <p>Trendings</p>
        </a>

        <a href="/listings?category=rooms" class="filter text-decoration-none text-dark <%= activeCategory === 'rooms' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>

        <a href="/listings?category=pools" class="filter text-decoration-none text-dark <%= activeCategory === 'pools' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pool</p>
        </a>

        <a href="/listings?category=iconic-cities" class="filter text-decoration-none text-dark <%= activeCategory === 'iconic-cities' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-city"></i></div>
            <p>Iconic cities</p>
        </a>

        <a href="/listings?category=mountains" class="filter text-decoration-none text-dark <%= activeCategory === 'mountains' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </a>

        <a href="/listings?category=castles" class="filter text-decoration-none text-dark <%= activeCategory === 'castles' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </a>

        <a href="/listings?category=camping" class="filter text-decoration-none text-dark <%= activeCategory === 'camping' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>

        <a href="/listings?category=farms" class="filter text-decoration-none text-dark <%= activeCategory === 'farms' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </a>

        <a href="/listings?category=domes" class="filter text-decoration-none text-dark <%= activeCategory === 'domes' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </a>

        <a href="/listings?category=boats" class="filter text-decoration-none text-dark <%= activeCategory === 'boats' ? 'active-filter' : '' %>">
           <div class="icon"><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </a>

    </div>

    <div class="tax-togel">
        <div class="form-check form-switch form-check-reverse">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>

</div>

<div class="container mt-4">
    <div class="row g-4">

        <% for(let list of alllisting){ %>

        <div class="col-lg-4 col-md-6 col-sm-12">

            <a href="/listings/<%= list._id %>" class="listing text-decoration-none text-dark">

                <div class="card h-100 listing-card">

                    <img src="<%= list.image.url %>" class="card-img-top" alt="list image">

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= list.title %>
                        </h5>

                        <p class="mt-2">
                            ₹ <%= list.price.toLocaleString("en-IN")%> / night
                            <i class="taxinfo" style="display: none;"> &nbsp; &nbsp;+18% GST</i>
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <% } %>

    </div>
</div>

<script>
let check = document.getElementById("switchCheckDefault");
check.addEventListener("click", () => {
    let tax = document.getElementsByClassName("taxinfo");
    for (let info of tax) {
        if (info.style.display != "inline") {
            info.style.display = "inline";
        } else {
            info.style.display = "none";
        }
    }
});
</script>