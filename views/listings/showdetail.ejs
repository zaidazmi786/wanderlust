<% layout("/layouts/boilerplate") %>
<script src="/js/map.js"></script>

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h2 class="card-title">
                <%= datainfo.title %>
            </h2>
            <div class="card shadow-lg border-0 rounded-4">

                <img src="<%= datainfo.image.url %>" class="card-img-top" alt="House Image"
                    style="height:450px; object-fit:cover;">

                <div class="card-body">
                    <p class="mt-3 mb-2 text-muted">
                        <i class="bi bi-person-circle me-1"></i>
                        Posted by:
                        <strong class="text-dark">
                            <%= datainfo.owner[0].username %>
                        </strong>
                    </p>

                    <p class="text-muted">
                        <%= datainfo.description %>
                    </p>

                    <hr>

                    <h4 class="text-success">
                        ₹ <%= datainfo.price.toLocaleString("en-IN") %> / night
                    </h4>

                    <p class="mb-1">
                        <strong>📍 Location:</strong>
                        <%= datainfo.location %>
                    </p>

                    <p>
                        <strong>🌍 Country:</strong>
                        <%= datainfo.contry %>
                    </p>

                    <% if (currentUser && datainfo.owner[0]._id.equals(currentUser._id)) { %>
                        <div class="d-flex gap-2 mt-4">
                            <a href="/listings/<%= datainfo._id %>/edit" class="btn btn-warning">
                                Edit
                            </a>
                            <form action="/listings/<%= datainfo._id %>?_method=DELETE" method="POST">
                                <button class="btn btn-danger">
                                    Delete
                                </button>
                            </form>
                        </div>
                        <% } %>

                </div>
            </div>

            <hr class="my-5">

            <!-- Leave a Review -->
            <% if (currentUser) { %>

                <form action="/listings/<%= datainfo._id %>/reviews" method="POST" class="needs-validation" novalidate autocomplete="off">

                    <div class="mb-3">
                        <fieldset class="starability-slot">
                            <legend>Rate this stay:</legend>
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                        <div class="invalid-feedback">Please select a rating.</div>
                    </div>

                    <div class="mb-3">
                        <label for="content" class="form-label">Review</label>
                        <textarea class="form-control" id="content" name="review[content]" rows="4" required></textarea>
                        <div class="invalid-feedback">Please enter your review.</div>
                    </div>

                    <button class="btn btn-dark w-100" type="submit">
                        Submit Review
                    </button>

                </form>

                <% } else { %>

                    <p class="text-center text-muted">
                        <a href="/login">Log in</a> to leave a review.
                    </p>

                    <% } %>

                    <hr class="my-5">

                    <!-- All Reviews -->
                    <h3 class="mb-4 text-center fw-bold">All Reviews</h3>
                    <% if(datainfo.reviews.length===0) { %>

                        <p class="text-muted text-center">No reviews yet. Be the first to review!</p>

                        <% } else { %>

                            <div class="row g-4">

                                <% for(let review of datainfo.reviews){ %>

                                    <div class="col-12 col-md-6">
                                        <div class="card shadow border-0 rounded-4 h-100">
                                            <div class="card-body p-4">

                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h6 class="fw-bold mb-0"><b>@<%= review.author[0].username %></b></h6>
                                                        <small class="text-warning">
                                                            <% for(let i=0; i<review.rating; i++){ %>⭐<% } %>
                                                        </small>
                                                    </div>
                                                    <span class="badge bg-dark rounded-pill">
                                                        <%= review.rating %>/5
                                                    </span>
                                                </div>

                                                <p class="card-text text-secondary mb-0 mt-3">
                                                    <%= review.content %>
                                                </p>

                                            </div>

                                            <% if (currentUser && review.author[0]._id.equals(currentUser._id)) { %>
                                                <div class="p-3 pt-0">
                                                    <form method="post"
                                                        action="/listings/<%= datainfo._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                        <button class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                                <% } %>

                                        </div>
                                    </div>

                                    <% } %>

                            </div>

                            <% } %>

                            <hr class="my-5">

                           

       </div>
 </div>
    </div>

<div>
<!-- Map Section -->
<div class="mb-3 map">
    <h4>Where you'll be</h4>
    <% 
        let hasValidCoords = datainfo.geometry 
            && datainfo.geometry.coordinates 
            && datainfo.geometry.coordinates.length === 2
            && !isNaN(datainfo.geometry.coordinates[0])
            && !isNaN(datainfo.geometry.coordinates[1]);
    %>
    <% if (hasValidCoords) { %>
        <div id="map" 
             data-lat="<%= datainfo.geometry.coordinates[1] %>" 
             data-lng="<%= datainfo.geometry.coordinates[0] %>"
             
             data-location="<%= datainfo.location %>"
             data-country="<%= datainfo.contry %>"
             
             style="height: 350px; border-radius: 8px;"></div>
    <% } else { %>
        <p class="text-muted">Map location not available for this listing.</p>
    <% } %>
</div>