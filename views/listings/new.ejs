<% layout("/layouts/boilerplate") %>




<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow p-4">
                <h2 class="text-center mb-4">Add New Listing</h2>

                <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input
                            type="text"
                            class="form-control"
                            name="listing[title]"
                            placeholder="Enter title"
                            required>
                             <div class="invalid-feedback">
        Please enter choose a title.
      </div>

      <div class="mb-3">
    <label class="form-label">Category</label>
    <select name="listing[category]" class="form-select" required>
        <option value="trending">Trending</option>
        <option value="rooms">Rooms</option>
        <option value="iconic-cities">Iconic Cities</option>
        <option value="mountains">Mountains</option>
        <option value="castles">Castles</option>
        <option value="pools">Amazing Pool</option>
        <option value="camping">Camping</option>
        <option value="farms">Farms</option>
        <option value="domes">Domes</option>
        <option value="boats">Boats</option>
    </select>
</div>
             </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea
                            class="form-control"
                            name="listing[description]"
                            rows="4"
                            placeholder="Enter description"
                            required></textarea>
                             <div class="invalid-feedback">
     Please enter choose a description.
      </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload Image</label>
                        <input
                            type="file"
                            class="form-control"
                            name="listing[image]"
                           
                   
                        </div>

                    <div class="mb-3">
                        <label class="form-label">Price (₹)</label>
                        <input
                            type="text"
                            class="form-control"
                            name="listing[price]"
                            placeholder="Enter price"
                            required>
                             <div class="invalid-feedback">
        Please enter a price.
      </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input
                            type="text"
                            class="form-control"
                            name="listing[location]"
                            placeholder="Enter location"
                            required>
                             <div class="invalid-feedback">
        Please enter a location.
      </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <input
                            type="text"
                            class="form-control"
                            name="listing[contry]"
                            placeholder="Enter country"
                            required>
                             <div class="invalid-feedback">
        Please enter  a contry.
      </div>
                    </div>

                    <button class="btn btn-dark w-100">
                        Add Listing
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>